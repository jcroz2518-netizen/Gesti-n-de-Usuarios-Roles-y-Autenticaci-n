FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=cambia-esta-clave
# SQLite por defecto. Ejemplos:
#   mysql+pymysql://usuario:clave@localhost/gestion
#   postgresql+psycopg://usuario:clave@localhost/gestion
DATABASE_URL=sqlite:///gestion.db
# Si MAIL_SERVER esta vacio, el enlace de recuperacion se muestra en la consola.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@gestion.local
